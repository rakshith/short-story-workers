{
  "version": "1.1.0",
  "description": "Model selection decision trees for LLM and vision models based on user tier",
  "models": {
    "openai-gpt-mini": {
      "id": "openai/gpt-5.4-mini",
      "provider": "OpenAI",
      "costTier": "cheap",
      "strengths": ["fast", "cost-effective"],
      "bestFor": ["basic creative work", "tier1 users"]
    },
    "openai-gpt-luna": {
      "id": "openai/gpt-5.6-luna",
      "provider": "OpenAI",
      "costTier": "medium",
      "strengths": ["balanced quality"],
      "bestFor": ["standard creative work", "tier2 users"]
    },
    "openai-gpt-terra": {
      "id": "openai/gpt-5.6-terra",
      "provider": "OpenAI",
      "costTier": "premium",
      "strengths": ["high quality"],
      "bestFor": ["premium creative work", "tier3 users"]
    },
    "openai-gpt-sol": {
      "id": "openai/gpt-5.6-sol",
      "provider": "OpenAI",
      "costTier": "ultra",
      "strengths": ["best quality", "complex reasoning"],
      "bestFor": ["luxury brands", "complex stories", "tier4 users"]
    },
    "gemini-flash-lite": {
      "id": "google/gemini-2.5-flash-lite",
      "provider": "Google",
      "costTier": "cheap",
      "strengths": ["fast", "cost-effective"],
      "bestFor": ["basic vision analysis", "tier1-t2 users"]
    },
    "gemini-flash": {
      "id": "google/gemini-3.1-flash-lite",
      "provider": "Google",
      "costTier": "premium",
      "strengths": ["better vision understanding", "higher accuracy"],
      "bestFor": ["premium vision analysis", "tier3-t4 users"]
    }
  },
  "decisionTree": {
    "field": "userTier",
    "branches": {
      "tier1": { "ref": "openai-gpt-mini" },
      "tier2": { "ref": "openai-gpt-luna" },
      "tier3": { "ref": "openai-gpt-terra" },
      "tier4": { "ref": "openai-gpt-sol" }
    }
  },
  "visionDecisionTree": {
    "field": "userTier",
    "branches": {
      "tier1": { "ref": "gemini-flash-lite" },
      "tier2": { "ref": "gemini-flash-lite" },
      "tier3": { "ref": "gemini-flash" },
      "tier4": { "ref": "gemini-flash" }
    }
  }
}
